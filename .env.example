# Groq API key for LLM generation (required for pipeline runs)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API key for web search retrieval (required for pipeline retrieval)
TAVILY_API_KEY=your_tavily_api_key_here

# Pinned model used across all pipeline evaluations
GROQ_MODEL=openai/gpt-oss-120b

# LLM provider backend (default: groq)
LLM_PROVIDER=groq

# Minimum quality score (1-10) to accept report without retry
QUALITY_THRESHOLD=7.0

# Hard abort token usage cap per pipeline run
TOKEN_LIMIT_PER_RUN=60000

# Faithfulness classifier judge backend: lr or cross_encoder
CLASSIFIER_BACKEND=lr

# Hugging Face Hub repo id or local path for the fine-tuned DistilBERT cross-encoder
FAITHFULNESS_CE_PATH=vaibhavarya/distilbert-faithfulness-nli

# Hugging Face access token (optional, only needed for uploading models or accessing private repos)
HF_TOKEN=your_hf_token_here
