# Groq API key for LLM generation (required for pipeline runs)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API key for web search retrieval (required for pipeline retrieval)
TAVILY_API_KEY=your_tavily_api_key_here

# Pinned model used across all pipeline evaluations
GROQ_MODEL=openai/gpt-oss-120b

# LLM provider backend (default: groq)
LLM_PROVIDER=groq

# Minimum quality score (1-10) to accept report without retry
QUALITY_THRESHOLD=7.0

# Hard abort token usage cap per pipeline run
TOKEN_LIMIT_PER_RUN=60000

# Faithfulness classifier judge backend: cross_encoder or lr
CLASSIFIER_BACKEND=cross_encoder

# Minimum fraction of claims supported by evidence to accept report without retry (System 4)
FAITHFULNESS_THRESHOLD=0.10

# Hugging Face Hub repo id or local path for the fine-tuned DistilBERT cross-encoder
FAITHFULNESS_CE_PATH=vaibhavarya/distilbert-faithfulness-nli

# Hugging Face access token (optional, only needed for uploading models or accessing private repos)
HF_TOKEN=your_hf_token_here

# Google Gemini API key for RAGAS evaluation judge (free tier, required for Gemini judge)
GOOGLE_API_KEY=your_google_api_key_here

# RAGAS evaluation judge provider (gemini or groq, default: gemini)
RAGAS_JUDGE_PROVIDER=gemini

# RAGAS evaluation judge model (default: auto-resolved 3.1 flash lite for gemini, or qwen/qwen3.8-27b for groq)
RAGAS_JUDGE_MODEL=

